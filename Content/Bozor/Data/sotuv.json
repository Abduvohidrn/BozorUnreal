    "MolTanlandi_iliq": ["{mahsulot}mi? Siz uchun bir {birlik} {narx} so'm, bolam."],
    "TushirdiMan_iliq": ["Odobingiz uchun {narx} so'm qilaman, bolam!", "Shunday odobli bolaga {narx} so'mdan beraman."],
