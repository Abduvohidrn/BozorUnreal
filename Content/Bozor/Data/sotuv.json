    "OshBolsin": ["Osh bo'lsin! Yana nima kerak?", "Osh bo'lsin, bolam!"],
    "TaroziUzr": ["Voy, rostdan ham! Uzr, bolam. Mana, {miqdor} {birlik}, {summa} so'm.", "Ko'zim ilg'amabdi, kechirasiz. To'g'riladim: {miqdor} {birlik} - {summa} so'm."],
    "TaroziTogri": ["Tarozini qarang, bolam: to'ppa-to'g'ri {miqdor} {birlik}. {summa} so'm.", "Yo'q, bolam, to'g'ri tortdim. {summa} so'm bo'ladi."],
    "TaroziKelishdi": ["Yaxshi, unda {summa} so'm bo'ladi.", "Xo'p, {summa} so'm, bolam."],
    "Xayr": ["Yana keling, bolam!", "Osh bo'lsin, yana keling!"],
    "XayrSotibOlmay": ["Mayli, boshqa safar keling!", "Xo'p, kerak bo'lsa qaytib keling."],
    "SalomBering": ["Avval salom bersangiz yaxshi bo'lardi, bolam.", "Salom-alik qilmaysizmi, bolam?"],
