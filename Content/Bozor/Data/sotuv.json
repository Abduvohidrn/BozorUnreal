  "fellar": {
    "mehribon": {
      "izoh": "Tez tushiradi, iliq gapiradi",
      "engPast": 0.80, "qadam": 0.08, "rad": 0.15, "odob": 15, "qopol": -10,
      "gaplar": {
        "KutibOlish": ["Keling, bolam! Nima kerak? Bizda {mollar} bor.", "Assalomu alaykum, o'g'lim! Qarang, {mollar} - hammasi yangi."],
        "Salom": ["Va alaykum assalom, bolam! Keling, nima olasiz?"],
        "TushirdiMan": ["Mayli, siz uchun {narx} so'm qilaman."],
        "TushirdiMan_iliq": ["Siz odobli bola ekansiz, {narx} so'mdan beraman.", "Odobingizga qoyil, bolam! {narx} so'm bo'la qolsin."],
        "QopolgaRad": ["Voy bolam, kattalarga bunaqa gapirmaydi. Narxi shu."]
      }
    },
    "qattiq": {
      "izoh": "Kam tushiradi, qisqa gapiradi",
      "engPast": 0.92, "qadam": 0.04, "rad": 0.5, "odob": 8, "qopol": -25,
      "gaplar": {
        "KutibOlish": ["Ha, nima kerak?", "Keling. {mollar} bor. Narxi yozib qo'yilgan."],
        "Salom": ["Vaalaykum assalom. Nima olasiz?"],
        "TushirmaymanHozircha": ["Narxi shu. Tushmaydi.", "Bu narx ham arzon, boshqa joyda qimmatroq."],
        "TushirdiMan": ["Mayli, {narx}. Bundan pasti yo'q."]
      }
    },
    "shoshqaloq": {
      "izoh": "Shoshib turadi, savdoni tez tugatmoqchi",
      "engPast": 0.88, "qadam": 0.06, "rad": 0.3, "odob": 10, "qopol": -15, "xatoQaytim": 0.15,
      "gaplar": {
        "KutibOlish": ["Ha, tez ayting, nima olasiz?", "Keling-keling, {mollar} bor, qaysi biri kerak?"],
        "MiqdorSora": ["Nechta? Tezroq ayting, bolam."],
        "TushirdiMan": ["Xo'p, {narx}, bo'ldi, oling!"]
      }
    },
    "ayyor": {
      "izoh": "Muloyim, lekin ba'zan qaytimni kam beradi",
      "engPast": 0.85, "qadam": 0.05, "rad": 0.35, "odob": 12, "qopol": -12, "xatoQaytim": 0.5,
      "gaplar": {
        "KutibOlish": ["Ooo, keling, keling! Eng zo'r {mollar} faqat menda!", "Keling, bolam, sizga eng yaxshisini tanlab beraman."],
        "TushirmaymanHozircha": ["Voy, bundan arzon bersam o'zim zarar qilaman-ku!"]
      }
    }
  },

