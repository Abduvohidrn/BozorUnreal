  "gaplarIzoh": "Sotuvchi javoblari: kalit - EBozorJavob nomi, qiymat - variantlar. O'rinlar: {mahsulot} {mollar} {birlik} {narx} {summa} {miqdor} {son} {qaytim}. '_iliq' (munosabat 70+) va '_sovuq' (30 dan past) variantlari ham bo'lishi mumkin. Fe'l gaplari (fellar.*.gaplar) bulardan ustun. Ovoz: AI/tts/gaplar_yoz.py har gapni o'rinlar bo'yicha bo'laklab Navoiy bilan yozadi (fe'lning 'uslub'ida) - matn o'zgarsa, qayta yozish va import kerak (Scripts/import_gaplar.py).",
  "gaplar": {
    "KutibOlish": ["Keling, bolam! Nima kerak? Bizda {mollar} bor."],
    "Salom": ["Va alaykum assalom, bolam! Keling, nima kerak?", "Vaalaykum assalom! Keling, {mahsulot} yangi uzilgan."],
    "MolSora": ["Qaysi biridan olasiz? Bizda {mollar} bor.", "Nima kerak, bolam? {mollar} bor."],
    "MolTanlandi": ["{mahsulot} - bir {birlik} {narx} so'm.", "{mahsulot} juda yaxshi, bolam. Bir {birlik} {narx} so'm."],
    "Narx": ["Bir {birlik} {mahsulot} {narx} so'm.", "{narx} so'mdan, bolam. Hammasi yangi."],
    "TushirdiMan": ["Mayli, siz uchun {narx} so'm qilaman.", "Xo'p, {narx} so'mdan bera qolay."],
    "TushirmaymanEngPast": ["Yo'q bolam, {narx} so'mdan arzon bo'lmaydi, o'zimga ham shunga tushgan.", "Bundan arzoni yo'q, rostini aytyapman. {narx} so'm."],
    "TushirmaymanHozircha": ["Narxi shu, bolam, juda yaxshi mol.", "{narx} so'm ham arzon-ku!"],
    "MiqdorSora": ["Necha {birlik} beray?", "Qancha olasiz, bolam? Necha {birlik}?"],
    "Tortdim": ["Mana, {miqdor} {birlik} {mahsulot}. Jami {summa} so'm bo'ldi.", "Mana: {miqdor} {birlik}. {summa} so'm bo'ladi, bolam."],
    "PulYetmaydi": ["Bu yetmaydi, bolam. {summa} so'm kerak, yana {son} so'm bering."],
    "HamyondaYoq": ["Hamyoningizda buncha pul yo'q-ku, bolam? Bor pulingizni sanab ko'ring."],
    "PulOldim": ["Rahmat! Mana qaytimingiz: {qaytim}.", "Oldim. Mana qaytimi: {qaytim}. Sanab oling."],
    "PulOldimAniq": ["Rahmat, bolam, to'ppa-to'g'ri! Osh bo'lsin!"],
